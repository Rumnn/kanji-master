# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local: mongodb://127.0.0.1:27017/kanji_master
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kanji_master?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/kanji_master

# JWT Secret (change this in production!)
JWT_SECRET=super_secret_kanji_key_12345
JWT_EXPIRES_IN=30d

# Comma-separated emails that should be admin at registration time.
# Leave blank in production and promote users from an existing admin account when possible.
ADMIN_EMAILS=

# Comma-separated allowed browser origins. Empty allows all origins only in development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
